{
    "name": "setono/sylius-plugin-pack",
    "description": "A pack that installs dependencies for Sylius plugin development",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "ergebnis/composer-normalize": "^2.50",
        "infection/infection": "~0.29.8",
        "jangregor/phpstan-prophecy": "^2.3",
        "matthiasnoback/symfony-dependency-injection-test": "^5.1",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.44",
        "phpstan/phpstan-doctrine": "^2.0.20",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpstan/phpstan-strict-rules": "^2.0.10",
        "phpstan/phpstan-symfony": "^2.0.15",
        "phpunit/phpunit": "^9.6.34",
        "rector/rector": "^2.3.9",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "sylius-labs/coding-standard": "^4.5",
        "sylius/sylius": "~1.14.19"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "abandoned": "report",
            "block-insecure": false
        },
        "sort-packages": true
    },
    "extra": {
        "phpstan": {
            "includes": [
                "phpstan/extension.neon"
            ]
        }
    }
}
